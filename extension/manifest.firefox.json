{
  "manifest_version": 3,
  "name": "SpiderPet",
  "version": "3.4.0",
  "description": "A spider that crawls the page, harvests DOIs, ISBNs, titles and key facts, and checks them with your local AI.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spiderpet@codingiscoolfr",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png" },
  "action": { "default_title": "SpiderPet: start or stop the spider on this page", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "scripts": ["background.js"] },
  "permissions": ["nativeMessaging", "storage", "scripting", "tabs", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Start or stop the spider on this page" }
  }
}
